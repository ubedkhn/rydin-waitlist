{
  "name": "rydin-waitlist-server",
  "version": "1.0.0",
  "private": true,
  "description": "Rydin waitlist API — Express + MongoDB, engineered for 4–5k RPM.",
  "main": "server.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:single": "node src/single.js",
    "dev": "node --watch src/single.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "compression": "1.7.4",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-rate-limit": "7.4.0",
    "helmet": "7.1.0",
    "mongoose": "8.5.1"
  },
  "optionalDependencies": {
    "ioredis": "5.4.1",
    "rate-limit-redis": "4.2.0"
  }
}
