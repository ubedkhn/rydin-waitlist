# ---------------------------------------------------------------------------
# Rydin waitlist — frontend environment
#
# Copy to `.env.local` (git-ignored) and edit. Only NEXT_PUBLIC_* variables are
# readable in the browser, and this app needs exactly one.
# ---------------------------------------------------------------------------

# Origin of the Express API in `server/`.
#
# Leave it EMPTY in production when the API sits behind the same origin as the
# site (a reverse proxy or a Next rewrite mapping /api/* to the backend) —
# `lib/rydin/api.ts` then issues relative requests, which avoids CORS entirely
# and keeps the browser on one connection.
#
# Set it while developing the two servers separately:
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Note: no key, token, or Mongo URI belongs in this file. The browser bundle is
# public, so anything NEXT_PUBLIC_ is effectively published. Database
# credentials live only in `server/.env`.
